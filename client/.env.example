# RSP Frontend Environment Variables
# Copy this file to .env.local for local development
# Set VITE_API_URL in your production hosting dashboard (Vercel/Netlify/etc.)

# Local development (default fallback when not set)
VITE_API_URL=http://localhost:5000

# Production example (set this in Vercel/Netlify environment variables):
# VITE_API_URL=https://your-rsp-backend.onrender.com
